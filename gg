(() => {
  const seen = e => e.getClientRects().length > 0;
  const dates = [...document.querySelectorAll('td.fc-day[data-date]')].filter(seen).map(c => c.dataset.date);
  const tiles = [...document.querySelectorAll('.fc-content-skeleton .fc-event')].filter(seen);
  console.log(JSON.stringify({
    views: [...document.querySelectorAll('.fc-view')].filter(seen).map(v => v.className),
    cells: dates.length, first: dates.slice(0, 8), last: dates.slice(-2),
    weekdays: [...new Set(dates.map(d => new Date(d + 'T12:00').getDay()))].sort(),
    tiles: tiles.length,
    hours: tiles.map(t => [...t.querySelectorAll('.field')].filter(f => /^hours/i.test(f.textContent.trim())).map(f => f.querySelector('.field-value')?.textContent.trim()).join('|') || 'none'),
  }));
})();
