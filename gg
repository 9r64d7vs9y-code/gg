(async () => {
  const options = window.snoozeCalendarProbeOptions || {};
  const QUIET = options.quiet ?? 800, POLL = options.poll ?? 100, AGAIN = options.again ?? 2000, LIMIT = options.limit ?? 300000;
  const sleep = options.sleep || (ms => new Promise(resolve => setTimeout(resolve, ms))), clock = options.now || (() => Date.now());
  const shown = node => { if (!node) return false; const s = getComputedStyle(node); return s.display !== 'none' && s.visibility !== 'hidden' && node.getClientRects().length > 0; };
  const words = node => (node?.textContent || '').replace(/\s+/g, ' ').trim();
  const started = clock(), at = () => ((clock() - started) / 1000).toFixed(1);
  const report = { probe: 'calendar save 1', changes: [] }, lines = ['Calendar save probe 1 (reads only; saves nothing)'];
  document.querySelector('[data-snooze-calendar-probe]')?.remove();
  const panel = document.createElement('div');
  panel.setAttribute('data-snooze-calendar-probe', '');
  panel.style.cssText = 'position:fixed;left:8px;bottom:8px;z-index:2147483647;max-width:760px;max-height:60vh;overflow:auto;background:#111;color:#eee;font:12px/1.4 monospace;padding:10px;border:2px solid #6cf';
  const stop = document.createElement('button');
  stop.textContent = 'Stop';
  stop.style.cssText = 'float:right;font:12px sans-serif;margin-left:8px';
  const text = document.createElement('pre');
  text.style.cssText = 'margin:0;white-space:pre-wrap';
  panel.append(stop, text);
  document.body.append(panel);
  let stopped = false;
  stop.addEventListener('click', () => { stopped = true; });
  const show = () => { text.textContent = lines.join('\n'); };
  const BUSY = 'div.loading, .blockUI.blockOverlay, .loading-overlay';
  const covers = () => [...document.querySelectorAll(BUSY)].filter(node => shown(node) && getComputedStyle(node).pointerEvents !== 'none').length;
  const content = node => {
    const control = node.closest('[id^="controlCalendar_"]');
    if (!control) return true;
    if (!control.querySelector(':scope > .fc-toolbar')) return false;
    return !node.closest('.fc-view-container, .fc-view');
  };
  const styled = node => !node || node === document.body || !node.hidden && getComputedStyle(node).display !== 'none' && getComputedStyle(node).visibility !== 'hidden'
    && (!node.classList.contains('tab-pane') || node.classList.contains('active')) && styled(node.parentElement);
  const laidOut = () => document.body.getBoundingClientRect().width > 0;
  const datedCell = cell => { if (!styled(cell)) return false; if (!laidOut()) return true; const box = cell.getBoundingClientRect(); return box.width > 0 && box.height > 0; };
  const views = () => [...document.querySelectorAll('.fc-view')].filter(view => content(view) && styled(view) && [...view.querySelectorAll('td.fc-day[data-date]')].some(datedCell));
  const gridColumn = target => {
    const table = target.closest('table');
    if (!table) return null;
    const rows = [...table.querySelectorAll(':scope > tbody > tr, :scope > tr')], taken = [];
    for (let r = 0; r < rows.length; r++) {
      let col = 0;
      for (const cell of rows[r].children) {
        while (taken[r]?.[col]) col++;
        if (cell === target) return cell.colSpan === 1 ? col : null;
        for (let dr = 0; dr < Math.min(cell.rowSpan, rows.length - r); dr++) for (let dc = 0; dc < cell.colSpan; dc++) (taken[r + dr] ||= [])[col + dc] = true;
        col += cell.colSpan;
      }
    }
    return null;
  };
  const isoOf = value => {
    if (typeof value?.format === 'function') return value.format('YYYY-MM-DD');
    if (Object.prototype.toString.call(value) === '[object Date]') return value.toISOString().slice(0, 10);
    return typeof value === 'string' ? value.slice(0, 10) : null;
  };
  const nextIso = iso => { const d = new Date(`${iso}T12:00:00Z`); d.setUTCDate(d.getUTCDate() + 1); return d.toISOString().slice(0, 10); };
  const kind = client => /^leave of absence/i.test(client) ? 'LOA' : /^do not schedule/i.test(client) ? 'DNS' : /holiday/i.test(client) ? 'Holiday' : client ? 'other client' : 'no name';
  const readTile = (tile, view) => {
    const fields = [...tile.querySelectorAll('.field')], labelled = fields.some(field => field.querySelector('.field-label'));
    const value = label => { const found = fields.filter(field => words(field.querySelector('.field-label')).replace(/:$/, '').toLowerCase() === label.toLowerCase()); return found.length === 1 ? words(found[0].querySelector('.field-value')) : ''; };
    const client = labelled ? value('Name') : [...tile.childNodes].filter(node => node.nodeType === 3).map(node => node.textContent).join(' ').trim();
    const hours = (labelled ? value('Hours') : words(tile.querySelector('.field-value'))).match(/^(\d+(?:\.\d+)?)h$/);
    const note = !!tile.querySelector('i.fa-note-sticky, i.fa-sticky-note, [class*="note"]');
    const row = { kind: kind(client), hours: hours ? Number(hours[1]) : null, note, day: null, how: '' };
    const skeleton = tile.closest('.fc-content-skeleton');
    if (!skeleton) {
      const cell = tile.closest('td.fc-day[data-date]');
      row.day = tile.getAttribute('data-date') || cell?.getAttribute('data-date') || null; row.how = 'dated tile'; return row;
    }
    const week = tile.closest('.fc-row.fc-week'), cell = tile.closest('td.fc-event-container');
    if (tile.closest('.fc-view') !== view) { row.how = 'other view'; return row; }
    if (!week || !cell || cell.closest('.fc-content-skeleton') !== skeleton) { row.how = 'no week row'; return row; }
    const dates = [...week.querySelectorAll('.fc-bg td.fc-day')].filter(node => node.closest('.fc-row') === week);
    const col = gridColumn(cell);
    if (col === null || col >= dates.length) { row.how = 'no column'; return row; }
    const day = dates[col].getAttribute('data-date');
    try {
      const data = window.jQuery?.(tile), seg = data?.data('fcSeg'), event = data?.data('event');
      if (!seg || seg.leftCol !== col || seg.rightCol !== col) { row.how = 'segment disagrees'; return row; }
      if (event && (event.start != null && isoOf(event.start) !== day || event.end != null && isoOf(event.end) !== nextIso(day))) { row.how = 'event dates disagree'; return row; }
    } catch { row.how = 'segment unreadable'; return row; }
    row.day = day; row.how = 'week row'; return row;
  };
  const read = () => {
    const found = views();
    if (found.length !== 1) return { error: `${found.length} calendar views shown` };
    const view = found[0];
    const days = [...view.querySelectorAll('td.fc-day[data-date]')].map(node => node.getAttribute('data-date')).sort();
    const tiles = [...document.querySelectorAll('.fc-event')].filter(tile => content(tile) && shown(tile) && !panel.contains(tile)).map(tile => readTile(tile, view));
    const keys = tiles.filter(row => row.day).map(row => `${row.day} ${row.kind} ${row.hours ?? '?'}h${row.note ? ' note' : ''}`).sort();
    return { from: days[0], to: days[days.length - 1], tiles: tiles.length, unread: tiles.filter(row => !row.day).map(row => row.how), keys };
  };
  const counted = list => { const map = new Map(); for (const key of list) map.set(key, (map.get(key) || 0) + 1); return map; };
  const difference = (before, after) => {
    const a = counted(before), b = counted(after), added = [], removed = [];
    for (const [key, n] of b) for (let i = a.get(key) || 0; i < n; i++) added.push(key);
    for (const [key, n] of a) for (let i = b.get(key) || 0; i < n; i++) removed.push(key);
    return { added, removed };
  };
  const brief = list => list.length > 12 ? [...list.slice(0, 12), `… ${list.length - 12} more`] : list;
  let saveAt = null, saveWord = '';
  const SAVES = /^(add|apply & add more|submit|save|ok|yes|delete|delete all|confirm)$/i;
  const onClick = event => {
    const button = event.target.closest?.('button, a.btn, input[type="submit"], input[type="button"]');
    if (!button || panel.contains(button)) return;
    const word = words(button) || button.value || '';
    if (SAVES.test(word.trim())) { saveAt = clock(); saveWord = word.trim(); }
  };
  document.addEventListener('click', onClick, true);
  let last = read();
  if (last.error) lines.push(`Start: ${last.error}. Open the test person's calendar first.`);
  else {
    lines.push(`Start at ${at()} s: calendar ${last.from} to ${last.to}; ${last.tiles} entries shown, ${last.keys.length} read${last.unread.length ? `, ${last.unread.length} not read (${[...new Set(last.unread)].join(', ')})` : ''}.`);
    lines.push('Now save a change by hand on this test person; wait for "Change n" after each. Press Stop when done.');
  }
  report.start = last; show();
  let coverSeen = false, coverFrom = null, coverSeconds = 0, clearSince = null, changedDom = false;
  const watch = new MutationObserver(records => { if (records.some(record => !panel.contains(record.target))) changedDom = true; });
  watch.observe(document.body, { subtree: true, childList: true, attributes: true, characterData: true });
  while (!stopped && clock() - started < LIMIT && !last.error) {
    await sleep(POLL);
    const now = clock();
    if (covers()) { if (!coverSeen) coverFrom = now; coverSeen = true; clearSince = null; continue; }
    if (coverFrom !== null) { coverSeconds += (now - coverFrom) / 1000; coverFrom = null; }
    clearSince ??= now;
    if (!changedDom || now - clearSince < QUIET) continue;
    const windowOpen = [...document.querySelectorAll('.modal')].some(node => shown(node) && !panel.contains(node));
    if (windowOpen) continue;
    changedDom = false;
    const readAt = clock(), next = read();
    if (next.error) { lines.push(`At ${at()} s: ${next.error}.`); show(); continue; }
    const diff = difference(last.keys, next.keys);
    if (!diff.added.length && !diff.removed.length && next.unread.length === last.unread.length && next.from === last.from && next.to === last.to) { coverSeen = false; coverSeconds = 0; continue; }
    await sleep(AGAIN);
    const again = read(), steady = !again.error && difference(next.keys, again.keys).added.length === 0 && difference(next.keys, again.keys).removed.length === 0;
    const change = {
      n: report.changes.length + 1, after: saveAt ? saveWord : 'no save press seen',
      readSecondsAfterSave: saveAt ? Number(((readAt - saveAt) / 1000).toFixed(1)) : null,
      coverSeen, coverSeconds: Number(coverSeconds.toFixed(1)), shown: `${next.from} to ${next.to}`,
      added: diff.added, removed: diff.removed, unread: next.unread, sameAgain: steady
    };
    report.changes.push(change);
    lines.push('', `Change ${change.n} (after "${change.after}"): read ${change.readSecondsAfterSave ?? '?'} s after the press; loading cover ${coverSeen ? `${change.coverSeconds} s` : 'not seen'}; calendar ${change.shown}.`);
    if (next.from !== last.from || next.to !== last.to) lines.push(`  The calendar moved: was ${last.from} to ${last.to}.`);
    lines.push(`  Added: ${diff.added.length ? brief(diff.added).join('; ') : 'none'}`, `  Removed: ${diff.removed.length ? brief(diff.removed).join('; ') : 'none'}`);
    if (next.unread.length) lines.push(`  Not read: ${next.unread.length} (${[...new Set(next.unread)].join(', ')})`);
    lines.push(`  Same ${AGAIN / 1000} s later: ${steady ? 'yes' : 'NO'}`);
    show();
    last = steady ? next : again; saveAt = null; coverSeen = false; coverSeconds = 0;
  }
  watch.disconnect();
  document.removeEventListener('click', onClick, true);
  report.end = last;
  lines.push('', `Stopped at ${at()} s: ${report.changes.length} change${report.changes.length === 1 ? '' : 's'} seen. Send a photo of this panel.`);
  stop.remove(); show();
  console.log(JSON.stringify(report, null, 1));
  try { copy(JSON.stringify(report)); } catch {   }
})();
