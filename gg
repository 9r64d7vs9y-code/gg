/*
 * Snooze Tax identity probe — read-only. Run on Tax MySource, Schedule, Staff
 * tab, with the test person's schedule open by hand (week view).
 * Clicks nothing, saves nothing, sends nothing. Prints only whether the
 * person's id marks and links exist and agree, never an id, name or link.
 * Copy the lines it prints.
 */
(() => {
  const out = [];
  const wrapper = document.querySelector('.staff-calendar-wrapper');
  if (!wrapper) { console.log('no .staff-calendar-wrapper'); return; }
  const desc = node => `${node.tagName.toLowerCase()}${[...node.classList].map(c => '.' + c).join('')}`;
  const shown = node => !!(node.offsetWidth || node.offsetHeight || node.getClientRects().length);
  const grid = node => node.closest('.fc-view-container, .fc-toolbar');
  // Snooze's identity check: one data-entity-id in the wrapper, matched by a link button.
  const marks = [wrapper, ...wrapper.querySelectorAll('*')].filter(node => node.hasAttribute('data-entity-id'));
  out.push(`data-entity-id in wrapper: ${marks.length}`);
  marks.slice(0, 5).forEach(node => out.push(`  on ${desc(node)} digitsOnly=${/^\d+$/.test(node.getAttribute('data-entity-id') || '')}`));
  const id = marks.length === 1 ? marks[0].getAttribute('data-entity-id') : null;
  const buttons = [...wrapper.querySelectorAll('a.btn[href]')].filter(shown);
  const forecast = buttons.filter(link => link.getAttribute('aria-label') === 'Forecast View');
  out.push(`shown a.btn links: ${buttons.length}, Forecast View: ${forecast.length}`);
  const hrefs = (forecast.length ? forecast : buttons).map(link => link.getAttribute('href') || '').filter(href => /\d/.test(href));
  out.push(`links with digits: ${hrefs.length}`);
  if (id && /^\d+$/.test(id)) out.push(`a link carries the id: ${hrefs.some(href => new RegExp(`(?:^|\\D)${id}(?:\\D|$)`).test(href))}`);
  // Other places a person id might sit: attribute names only, outside the grid.
  const seen = new Map();
  [wrapper, ...wrapper.querySelectorAll('*')].filter(node => !grid(node)).forEach(node => {
    for (const attr of node.attributes) {
      if (/^(class|style|title|aria-|role)/.test(attr.name)) continue;
      if (!/\d/.test(attr.value)) continue;
      const key = `${desc(node)} [${attr.name}]${attr.name === 'href' ? '' : ` digitsOnly=${/^\d+$/.test(attr.value)}`}`;
      seen.set(key, (seen.get(key) || 0) + 1);
    }
  });
  out.push(`attributes with digits outside the calendar grid: ${seen.size}`);
  [...seen].slice(0, 25).forEach(([key, count]) => out.push(`  ${key} x${count}`));
  console.log(out.join('\n'));
})();
