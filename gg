(() => {
  const shown = node => { const s = getComputedStyle(node); return s.display !== 'none' && s.visibility !== 'hidden' && node.getClientRects().length > 0; };
  const words = node => (node.textContent || '').replace(/\s+/g, ' ').trim().slice(0, 40);
  const mask = value => String(value || '').replace(/\d{3,}/g, '#');
  const buttons = [...document.querySelectorAll('.fc-toolbar button, .fc-header-toolbar button, .fc-right button, .fc-left button')].map(b => ({
    classes: [...b.classList].map(mask).join(' '), words: words(b), title: b.title || b.getAttribute('aria-label') || '', shown: shown(b),
    icon: [...b.querySelectorAll('i, span, svg')].map(i => [...(i.classList || [])].join(' ')).filter(Boolean).slice(0, 3),
  }));
  const settings = [...document.querySelectorAll('button.fc-settings-button')].map(b => ({ shown: shown(b), words: words(b) }));
  const menus = [...document.querySelectorAll('.dropdown-menu, [role=menu], .context-menu-list, ul.dropdown, .popover')].filter(shown).map(menu => ({
    classes: [...menu.classList].map(mask).join(' '),
    items: [...menu.querySelectorAll('a, button, li, .dropdown-item')].filter(shown).map(item => `${item.tagName.toLowerCase()}.${[...item.classList].map(mask).join('.')} "${words(item)}"`).slice(0, 20),
  }));
  const dialogs = [...document.querySelectorAll('.modal, [role=dialog]')].filter(shown).map(d => ({ title: words(d.querySelector('.modal-title, h4, h5') || d), selects: d.querySelectorAll('select').length, inputs: d.querySelectorAll('input:not([type=hidden])').length }));
  const text = JSON.stringify({ probe: 'tax-periods 2026-10-30', toolbarButtons: buttons, settingsButtons: settings, openMenus: menus, openWindows: dialogs }, null, 1);
  console.log(text);
  try { copy(text); console.log('Copied to the clipboard.'); } catch {   }
})();
