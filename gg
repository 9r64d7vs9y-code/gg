/*
 * Snooze site check — read-only (Claude, 2026-10-26).
 * Paste into the console on Tax MySource > Schedule > Calendar view, menus
 * closed. It clicks nothing and changes nothing. It prints only what Snooze's
 * site check looks at: the tab names, and whether the Tax Resource Center
 * link is there. No person's name or schedule.
 */
(() => {
  const key = value => String(value || '').replace(/\s+/g, ' ').trim().toLowerCase();
  const shown = node => { const s = getComputedStyle(node); return s.display !== 'none' && s.visibility !== 'hidden' && node.getClientRects().length > 0; };
  const outside = node => !node.closest('#snooze-panel-host, #snooze-panel');
  const tabs = [...document.querySelectorAll('[role="tab"], .nav-tabs a, .nav-tabs button')].filter(outside);
  const links = [...document.querySelectorAll('a')].filter(outside).filter(node => /tax\s*resource/i.test(node.textContent));
  console.log(JSON.stringify({
    tabs: tabs.map(node => ({ text: key(node.textContent).slice(0, 40), shown: shown(node) })),
    taxLinks: links.map(node => ({ text: key(node.textContent).slice(0, 60), shown: shown(node) })),
    staffTabShown: tabs.some(node => shown(node) && key(node.textContent) === 'staff'),
    professionalTabShown: tabs.some(node => shown(node) && key(node.textContent) === 'professional'),
    exactTaxLink: links.some(node => key(node.textContent) === 'mysource tax resource center'),
  }, null, 1));
})();
