(() => {
  const words = node => (node?.textContent || '').replace(/\s+/g, ' ').trim();
  const loose = value => value.toLowerCase().replace(/[^a-z0-9]+/g, '');
  const kind = value => /leave of absence|\(loa\)/i.test(value) ? 'LOA' : /do not schedule|\(dns\)/i.test(value) ? 'DNS' : /holiday/i.test(value) ? 'Holiday' : 'client';
  const shape = value => [/\(\d+(?:\.\d+)?\)\s*$/.test(value) ? 'ends (n.nn)' : '', /:\s*\d+\s*$/.test(value) ? 'ends : digits' : '', /\s-\s/.test(value) ? 'has " - "' : ''].filter(Boolean).join(', ') || 'plain';
  const modal = document.querySelector('#editEventGridModal');
  const clients = modal ? [...modal.querySelectorAll('td.column-clientname')].map(words).filter(Boolean) : [];
  const unique = [...new Set(clients)];
  const tiles = [...document.querySelectorAll('.fc-view .fc-event')].map(tile => {
    const fields = [...tile.querySelectorAll('.field')];
    const name = words(fields.find(field => /^name:?$/i.test(words(field.querySelector('.field-label'))))?.querySelector('.field-value'));
    const match = !name ? 'no Name field'
      : unique.includes(name) ? 'exact'
      : unique.some(client => client.toLowerCase() === name.toLowerCase()) ? 'case only'
      : unique.some(client => loose(client) === loose(name)) ? 'spaces or marks only'
      : unique.some(client => client.startsWith(name)) ? 'table text is longer (starts with Name)'
      : unique.some(client => name.startsWith(client)) ? 'Name is longer (starts with table text)'
      : unique.some(client => loose(client).includes(loose(name)) || loose(name).includes(loose(client))) ? 'one contains the other'
      : 'none';
    return { kind: kind(name), nameShape: name ? shape(name) : '', nameLength: name.length, match };
  });
  const result = {
    probe: 'tile-name 2026-10-30', tableOpen: !!modal && getComputedStyle(modal).display !== 'none', tableRows: clients.length,
    tableClientShapes: [...new Set(unique.map(client => `${kind(client)}: ${shape(client)}`))],
    tiles: tiles.slice(0, 30),
  };
  const text = JSON.stringify(result, null, 1);
  console.log(text);
  try { copy(text); console.log('Copied to the clipboard.'); } catch {   }
})();
