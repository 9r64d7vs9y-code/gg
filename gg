(() => {
  const words = node => (node?.textContent || '').replace(/\s+/g, ' ').trim();
  const shown = node => {
    for (let n = node; n && n.nodeType === 1; n = n.parentElement) {
      const s = getComputedStyle(n);
      if (s.display === 'none' || s.visibility === 'hidden' || n.getAttribute('aria-hidden') === 'true') return false;
    }
    return node.getClientRects().length > 0;
  };
  let before = null;
  const readTable = () => {
    const tables = [...document.querySelectorAll('table#editGrid')].filter(shown);
    if (!tables.length) return { problem: 'no Edit Assignment table is open. Open Find Assignments first.' };
    if (tables.length > 1) return { problem: 'more than one Edit Assignment table is shown.' };
    const table = tables[0];
    const holder = table.closest('.modal') || table.parentElement;
    const info = words(holder.querySelector('.dataTables_info')).match(/(\d+)\s+to\s+(\d+)\s+of\s+(\d+)/i);
    const trs = [...table.querySelectorAll('tbody tr')];
    if (trs.length === 1 && trs[0].querySelector('td.dataTables_empty')) return { problem: 'the table shows no rows (or is still loading).' };
    if (!trs.length) return { problem: 'the table has no rows yet (still loading?).' };
    if (info && Number(info[2]) - Number(info[1]) + 1 !== Number(info[3])) return { problem: `the table shows ${info[2]} of ${info[3]} rows; scroll or widen it so every row is drawn.` };
    if (info && Number(info[3]) !== trs.length) return { problem: `the table says ${info[3]} rows but draws ${trs.length}.` };
    const rows = [];
    for (const [index, tr] of trs.entries()) {
      const cell = name => tr.querySelector(`td.${name}`);
      const hoursCell = cell('column-hours');
      const box = hoursCell ? [...hoursCell.querySelectorAll('input')].filter(shown)[0] : null;
      const row = {
        id: tr.getAttribute('data-id') || '',
        date: words(cell('column-start')),
        hours: box ? String(box.value).trim() : words(hoursCell),
        client: words(cell('column-clientname')),
        notes: (words(cell('column-notesnumber')).match(/\((\d+)\)/) || [])[1] ?? '?',
      };
      if (!row.date || !row.hours || !hoursCell) return { problem: `row ${index + 1} has no readable date or hours.` };
      rows.push(row);
    }
    return { rows };
  };
  const rowLine = r => `${r.date} · ${r.hours} h · ${r.client || '(no client)'} · notes ${r.notes} · ID ${r.id || '(none)'}`;
  const key = r => `${r.date}|${r.client}`;
  const compare = (old, now) => {
    if (old.some(r => !r.id) || now.some(r => !r.id)) return { verdict: 'Could not tell: some rows have no row ID.', lines: [] };
    const oldById = new Map(old.map(r => [r.id, r]));
    const lines = [], counts = { kept: 0, changed: 0, unmatched: 0 };
    const usedOld = new Set();
    for (const r of now) {
      const same = oldById.get(r.id);
      if (same) { counts.kept++; usedOld.add(same); lines.push(`same ID     ${rowLine(r)}${same.hours !== r.hours ? ` (hours were ${same.hours})` : ''}`); continue; }
      const likely = old.filter(o => key(o) === key(r) && !now.some(n => n.id === o.id));
      const twins = now.filter(n => key(n) === key(r));
      if (likely.length === 1 && twins.length === 1) { counts.changed++; usedOld.add(likely[0]); lines.push(`CHANGED ID  ${rowLine(r)} (was ${likely[0].id}${likely[0].hours !== r.hours ? `, hours were ${likely[0].hours}` : ''})`); }
      else { counts.unmatched++; lines.push(`not matched ${rowLine(r)}${likely.length > 1 || twins.length > 1 ? ' (more than one row has this date and client)' : ''}`); }
    }
    for (const o of old) if (!usedOld.has(o)) lines.push(`gone        ${rowLine(o)}`);
    const m = now.length;
    let verdict;
    if (!m) verdict = 'Could not tell: no rows to compare.';
    else if (counts.unmatched) verdict = `Could not tell: ${counts.unmatched} of ${m} rows could not be matched to a row read before.`;
    else if (counts.changed) verdict = `Row numbers changed for ${counts.changed} of ${m} rows`;
    else verdict = 'Row numbers kept';
    return { verdict, lines, counts };
  };
  document.querySelector('[data-snooze-row-ids-probe]')?.remove();
  const panel = document.createElement('div');
  panel.setAttribute('data-snooze-row-ids-probe', '');
  panel.style.cssText = 'position:fixed;left:8px;bottom:8px;z-index:2147483647;max-width:900px;background:#111;color:#eee;font:12px/1.4 monospace;padding:10px;border:2px solid #6cf';
  const out = document.createElement('pre');
  out.style.cssText = 'white-space:pre-wrap;margin:0 0 8px 0;max-height:50vh;overflow:auto';
  const makeButton = (label, action) => {
    const b = document.createElement('button');
    b.type = 'button'; b.textContent = label;
    b.setAttribute('data-snooze-row-ids-probe-button', label);
    b.style.cssText = 'margin-right:8px;font:12px monospace;padding:3px 8px';
    b.addEventListener('click', event => { event.stopPropagation(); action(); });
    return b;
  };
  const show = lines => { out.textContent = lines.join('\n'); console.log(lines.join('\n')); };
  const readBefore = () => {
    const read = readTable();
    if (read.problem) { before = null; show(['Row IDs probe 1 · before', `Could not read: ${read.problem}`]); return; }
    before = read.rows;
    show(['Row IDs probe 1 · before', `${before.length} rows read and kept in memory:`, ...before.map(rowLine),
      '', 'Now, by hand: press one row\'s bin (or change one row\'s Hours) and Submit,',
      'open Find Assignments again over the same period, then press "Read after".']);
  };
  const readAfter = () => {
    if (!before) { show(['Row IDs probe 1 · after', 'Could not tell: press "Read before" first.']); return; }
    const read = readTable();
    if (read.problem) { show(['Row IDs probe 1 · after', `Could not tell: ${read.problem}`]); return; }
    const result = compare(before, read.rows);
    const note = read.rows.length === before.length ? 'Same number of rows as before (an hours change, or nothing was saved?).' : '';
    show(['Row IDs probe 1 · after', `Before: ${before.length} rows. After: ${read.rows.length} rows.`, ...result.lines, ...(note ? [note] : []), '', `Verdict: ${result.verdict}`]);
  };
  panel.append(out, makeButton('Read before', readBefore), makeButton('Read after', readAfter), makeButton('Close', () => panel.remove()));
  document.body.append(panel);
  show(['Row IDs probe 1', 'Open Find Assignments over a short test period (3 or more entries), then press "Read before".']);
})();
