/*
 * Snooze Tax identity probe 2 — read-only. Same place as probe 1: Tax
 * MySource, Schedule, Staff tab, the test person's schedule open by hand.
 * Clicks nothing, saves nothing, sends nothing. Prints only yes/no and counts,
 * never an id, name or link. Copy the lines it prints.
 */
(() => {
  const out = [];
  const wrapper = document.querySelector('.staff-calendar-wrapper');
  if (!wrapper) { console.log('no .staff-calendar-wrapper'); return; }
  const shown = node => !!(node.offsetWidth || node.offsetHeight || node.getClientRects().length);
  const has = (text, id) => new RegExp(`(?:^|\\D)${id}(?:\\D|$)`).test(text || '');
  const marks = [...wrapper.querySelectorAll('[data-entity-id]')];
  const ids = marks.map(node => node.getAttribute('data-entity-id'));
  out.push(`id marks: ${marks.length}, shown: ${marks.filter(shown).length}, all the same id: ${new Set(ids).size === 1}`);
  marks.forEach((node, i) => out.push(`  mark ${i + 1}: shown=${shown(node)} inside .fc=${!!node.closest('.fc')} inside #controlCalendar_staff=${!!node.closest('#controlCalendar_staff')} same row as the name link=${!!node.parentElement?.querySelector(':scope > span > a')}`));
  const id = ids[0];
  if (!id) { console.log(out.join('\n')); return; }
  // The name link and list icon in the header row, and the two calendars' record ids.
  const close = [...wrapper.querySelectorAll('a')].find(a => a.querySelector('i.fa-times') && shown(a));
  const row = close?.parentElement;
  const nameLink = row?.querySelector(':scope > span > a');
  const listIcon = row?.querySelector(':scope > a.schedule-icon');
  out.push(`name link found: ${!!nameLink}, its link carries the id: ${has(nameLink?.getAttribute('href'), id)}`);
  out.push(`list icon found: ${!!listIcon}, its link carries the id: ${has(listIcon?.getAttribute('href'), id)}`);
  out.push(`shown id mark in the name row: ${!!row && [...row.querySelectorAll('[data-entity-id]')].filter(shown).length}`);
  const calendars = [...wrapper.querySelectorAll('[data-record-id]')];
  calendars.forEach((node, i) => out.push(`  calendar ${i + 1}: shown=${shown(node)} size=${node.offsetWidth}x${node.offsetHeight} record id equals the id: ${node.getAttribute('data-record-id') === id}`));
  // Does the id appear anywhere else on the page, outside this person's schedule?
  const elsewhere = [...document.querySelectorAll('[data-entity-id]')].filter(node => !wrapper.contains(node));
  out.push(`id marks outside the schedule: ${elsewhere.length}, with the same id: ${elsewhere.filter(node => node.getAttribute('data-entity-id') === id).length}`);
  console.log(out.join('\n'));
})();
