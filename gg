// Snooze probe 2, read-only: clicks nothing, saves nothing, sends nothing. Structure and counts only, no names.
(() => {
  const vis = n => { const r = n.getBoundingClientRect(); return r.width > 0 && r.height > 0; };
  const inCtrl = n => !!n.closest('[id^="controlCalendar_"]');
  const lines = [];
  [...document.querySelectorAll('.fc-view')].forEach((v, i) => {
    const r = v.getBoundingClientRect();
    const cells = [...v.querySelectorAll('td.fc-day[data-date]')];
    lines.push(`VIEW ${i + 1}: ${v.className.split(/\s+/).filter(c => c.endsWith('-view')).join(' ')} inControlCalendar=${inCtrl(v)} height=${Math.round(r.height)} visible=${vis(v)} dayCells=${cells.length} visibleCells=${cells.filter(vis).length} first=${cells[0]?.dataset.date || '-'} entriesInside=${v.querySelectorAll('.fc-event').length}`);
  });
  const ev = [...document.querySelectorAll('.fc-event')];
  lines.push(`ENTRIES: total=${ev.length} visible=${ev.filter(vis).length} insideControlCalendar=${ev.filter(inCtrl).length}`);
  const tb = [...document.querySelectorAll('.fc-toolbar')];
  lines.push(`TOOLBARS: ${tb.length}; inControlCalendar=${tb.filter(inCtrl).length}; visible=${tb.filter(vis).length}`);
  const ctrl = document.querySelector('[id^="controlCalendar_"]');
  if (ctrl) lines.push(`controlCalendar children: ${[...ctrl.children].map(c => c.tagName.toLowerCase() + '.' + String(c.className).trim().split(/\s+/).slice(0, 2).join('.') + '(h=' + Math.round(c.getBoundingClientRect().height) + ')').join(', ')}`);
  console.log(lines.join('\n'));
})();
