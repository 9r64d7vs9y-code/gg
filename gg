/*
 * Snooze Tax name probe — read-only. Run on Tax MySource, Schedule, Staff tab,
 * with the test person's schedule open by hand (week view).
 * Clicks nothing, saves nothing, sends nothing. Prints only how the line with
 * the person's name is built (tags, classes, ids, text lengths), never the
 * name itself. Copy the lines it prints.
 */
(() => {
  const out = [];
  const wrapper = document.querySelector('.staff-calendar-wrapper');
  if (!wrapper) { console.log('no .staff-calendar-wrapper'); return; }
  const desc = node => `${node.tagName.toLowerCase()}${node.id ? '#' + node.id : ''}${[...node.classList].map(c => '.' + c).join('')}`;
  const ownText = node => [...node.childNodes].filter(n => n.nodeType === 3).map(n => n.textContent).join('').trim();
  out.push(`wrapper: ${desc(wrapper)}`);
  let parent = wrapper.parentElement;
  for (let i = 0; i < 3 && parent; i++, parent = parent.parentElement) out.push(`parent ${i + 1}: ${desc(parent)}`);
  // Everything in or just above the wrapper that is not part of the calendar grid.
  const scope = wrapper.parentElement || wrapper;
  [...scope.querySelectorAll('*')].filter(node => !node.closest('.fc-view-container') && !node.closest('.fc-toolbar')).forEach(node => {
    const own = ownText(node);
    const close = /[✕×xX]/.test(own) && own.length <= 2;
    if (own.length > 0 || node.matches('i, a, button, span')) {
      out.push(`${desc(node)} textLength=${own.length}${close ? ' (close mark)' : ''}${/\(.*-.*\)/.test(own) ? ' (looks like name line)' : ''} title=${node.title ? 'yes' : 'no'}`);
    }
  });
  console.log(out.slice(0, 60).join('\n'));
})();
