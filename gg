/*
 * Snooze Find Assignments labels check — read-only (Claude, 2026-10-29).
 * For the A&A "Clients" fault. On Consulting MySource > Schedule > Calendar
 * view, open an A&A LOA person's schedule by hand, right-click an entry and
 * choose Find Assignments, change nothing, then paste this into the console.
 * It clicks nothing and changes nothing. It prints the form's labels and box
 * types only, never a value; option words only for period/view-type boxes.
 * The result is also put on the clipboard (copy) to paste back to Claude.
 */
(() => {
  const shown = node => { const s = getComputedStyle(node); return s.display !== 'none' && s.visibility !== 'hidden' && node.getClientRects().length > 0; };
  const words = node => (node.textContent || '').replace(/\s+/g, ' ').trim();
  const mask = id => id ? id.replace(/\d+/g, '#') : null;
  const modals = [...document.querySelectorAll('.modal')].filter(shown);
  const modal = modals.find(node => /Find Assignments/i.test(words(node.querySelector('.modal-title, .modal-header') || node)));
  if (!modal) { console.log(`No open Find Assignments window found (${modals.length} open windows).`); return; }
  const forms = [...modal.querySelectorAll('form, .js-dynamic-form')];
  const control = label => {
    const byFor = label.htmlFor && document.getElementById(label.htmlFor);
    if (byFor) return { node: byFor, how: 'for' };
    const row = label.closest('.dynamic-form-row, .form-group, .mb-3') || label.parentElement;
    const node = row && row.querySelector('select, input:not([type=hidden]), textarea');
    return node ? { node, how: 'row' } : { node: null, how: 'none' };
  };
  const optionsSafe = /period|view|type|week|date|status/i;
  const labels = [...modal.querySelectorAll('label')].map(label => {
    const text = words(label), clean = text.replace(/[*?]/g, '').trim();
    const { node, how } = control(label);
    const info = { label: clean, raw: text === clean ? undefined : text, shown: shown(label), found: how };
    if (node) Object.assign(info, {
      box: node.tagName.toLowerCase() + (node.type && node.tagName !== 'SELECT' ? `[${node.type}]` : ''),
      id: mask(node.id), multiple: node.multiple || undefined, disabled: node.disabled || undefined,
      boxShown: shown(node) || (node.nextElementSibling && shown(node.nextElementSibling)) || false,
      options: node.tagName === 'SELECT' ? node.options.length : undefined,
      optionWords: node.tagName === 'SELECT' && optionsSafe.test(clean) && node.options.length <= 12 ? [...node.options].map(words) : undefined,
    });
    return info;
  });
  const result = {
    probe: 'find-labels 2026-10-29',
    windowTitle: words(modal.querySelector('.modal-title') || modal).slice(0, 40),
    forms: forms.map(form => ({ id: mask(form.id), class: [...form.classList].join('.'), shown: shown(form) })),
    labels,
    exactClients: labels.filter(item => item.label.toLowerCase() === 'clients').length,
    anyClient: labels.filter(item => /client/i.test(item.label)).map(item => item.label),
  };
  const out = JSON.stringify(result, null, 1);
  console.log(out);
  try { copy(out); console.log('Copied to the clipboard.'); } catch { console.log('Copy it from above.'); }
})();
