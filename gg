/*
 * Snooze Find anchor check — read-only (Claude, 2026-10-30).
 * For the Exit on leave whose Find still refused ("no proved client entry or
 * DNS entry in the current week") with the LOA-anchor snippet. On Consulting
 * MySource > Schedule > Calendar view, open that person's schedule by hand,
 * change nothing, then paste this into the console. It clicks nothing and
 * changes nothing. For each entry tile in this week it prints what Snooze
 * reads from it: the tile's own words (only LOA / DNS / Holiday words are
 * shown; a client shows as "client" or "other"), its dates and where it sits.
 * The result is also put on the clipboard (copy) to paste back to Claude.
 */
(() => {
  const shown = node => { const s = getComputedStyle(node); return s.display !== 'none' && s.visibility !== 'hidden' && node.getClientRects().length > 0; };
  const own = node => [...node.childNodes].filter(n => n.nodeType === 3).map(n => n.textContent).join(' ').replace(/\s+/g, ' ').trim();
  const all = node => (node.textContent || '').replace(/\s+/g, ' ').trim();
  const safe = text => /leave of absence|\(loa\)|do not schedule|\(dns\)|holiday|\(hol\)/i.test(text) ? text.slice(0, 40)
    : /^[^:]+:\s*\d+$/.test(text) ? 'client (name: number)' : text ? 'other words' : '(none)';
  const iso = value => /^\d{4}-\d{2}-\d{2}/.test(value || '') ? value.slice(0, 10) : value || null;
  const todayCell = document.querySelector('td.fc-today[data-date], td.fc-day.fc-today');
  const today = new Date(); const monday = new Date(today); monday.setDate(today.getDate() - ((today.getDay() + 6) % 7));
  const day = d => d.toISOString().slice(0, 10);
  const weekStart = day(new Date(Date.UTC(monday.getFullYear(), monday.getMonth(), monday.getDate())));
  const weekEnd = day(new Date(Date.UTC(monday.getFullYear(), monday.getMonth(), monday.getDate() + 6)));
  const views = [...document.querySelectorAll('.fc-view')];
  const tiles = [...document.querySelectorAll('.fc-event')].map(tile => {
    const cell = tile.closest('td.fc-day[data-date], td[data-date]');
    const date = iso(tile.getAttribute('data-date')) || iso(cell?.getAttribute('data-date'));
    return {
      ownWords: safe(own(tile)), allWords: safe(all(tile).replace(/^[\d.]+h\s*/, '').replace(/\s*JC:.*$/, '')),
      tileDate: iso(tile.getAttribute('data-date')), cellDate: iso(cell?.getAttribute('data-date')), date,
      thisWeek: !!date && date >= weekStart && date <= weekEnd,
      shown: shown(tile), inFcView: !!tile.closest('.fc-view'), inControl: !!tile.closest('[id^="controlCalendar_"]'),
      fcIndex: [...document.querySelectorAll('.fc')].indexOf(tile.closest('.fc')),
      classes: [...tile.classList].filter(c => !/\d{3,}/.test(c)).join(' '),
    };
  });
  const result = {
    probe: 'find-anchor 2026-10-30', weekStart, weekEnd,
    todayCell: todayCell ? iso(todayCell.getAttribute('data-date')) : null,
    fcCount: document.querySelectorAll('.fc').length, viewCount: views.length,
    viewsShown: views.map(shown), dayCells: document.querySelectorAll('td.fc-day[data-date]').length,
    tilesTotal: tiles.length, thisWeek: tiles.filter(t => t.thisWeek), firstOthers: tiles.filter(t => !t.thisWeek).slice(0, 3),
  };
  const text = JSON.stringify(result, null, 1);
  console.log(text);
  try { copy(text); console.log('Copied to the clipboard.'); } catch { /* copy() exists only in the DevTools console */ }
})();
