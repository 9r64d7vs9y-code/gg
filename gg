(async () => {
  const wait = ms => new Promise(done => setTimeout(done, ms));
  const pad = n => String(n).padStart(2, '0');
  const now = new Date();
  const monday = new Date(now.getFullYear(), now.getMonth(), now.getDate() - ((now.getDay() + 6) % 7));
  const date = `${monday.getFullYear()}-${pad(monday.getMonth() + 1)}-${pad(monday.getDate())}`;
  const seen = e => e.getClientRects().length > 0;
  const name = e => e ? e.tagName.toLowerCase() + [...e.classList].slice(0, 3).map(c => '.' + c).join('') : 'nothing';
  const cells = [...document.querySelectorAll(`td.fc-day[data-date="${date}"]`)].filter(seen).filter(c => !c.closest('[id^="controlCalendar_"]'));
  const lines = [`week ${date}; cells ${cells.length}`];
  const cell = cells[0];
  if (cell) {
    const shown = node => {
      for (let at = node; at && at.nodeType === 1; at = at.parentElement) {
        const style = getComputedStyle(at);
        if (at.hidden || (at !== node && at.getAttribute('aria-hidden') === 'true') || style.display === 'none' || style.visibility === 'hidden') return false;
      }
      return node.isConnected;
    };
    const menu = () => [...document.querySelectorAll('ul.context-menu-list.context-menu-root')].find(shown);
    const items = () => {
      const open = menu();
      return open ? [...open.querySelectorAll(':scope > li.context-menu-item')].filter(shown).map(li => li.textContent.trim() + (li.classList.contains('context-menu-disabled') ? ' (off)' : '')).join(', ') || 'no items' : 'no menu';
    };
    const close = async () => {
      document.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape', code: 'Escape', keyCode: 27, which: 27, bubbles: true, cancelable: true }));
      for (const layer of document.querySelectorAll('#context-menu-layer')) {
        layer.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape', code: 'Escape', keyCode: 27, which: 27, bubbles: true, cancelable: true }));
        layer.dispatchEvent(new MouseEvent('mousedown', { bubbles: true, cancelable: true, view: window, button: 0 }));
      }
      await wait(500);
    };
    cell.scrollIntoView({ block: 'nearest', inline: 'nearest' });
    await close();
    const box = cell.getBoundingClientRect();
    const spots = { 'Snooze bottom': box.bottom - 4, 'quarter up': box.bottom - box.height / 4, middle: box.top + box.height / 2 };
    lines.push(`cell height ${Math.round(box.height)}; window height ${innerHeight}`);
    for (const [spot, y] of Object.entries(spots)) {
      const x = Math.round(box.left + box.width / 2), top = Math.round(y);
      const on = document.elementFromPoint(x, top);
      const target = on || cell;
      const common = { bubbles: true, cancelable: true, composed: true, view: window, clientX: x, clientY: top, screenX: x, screenY: top };
      target.dispatchEvent(new PointerEvent('pointerdown', { ...common, button: 2, buttons: 2, pointerType: 'mouse' }));
      target.dispatchEvent(new MouseEvent('mousedown', { ...common, button: 2, buttons: 2 }));
      target.dispatchEvent(new PointerEvent('pointerup', { ...common, button: 2, buttons: 0, pointerType: 'mouse' }));
      target.dispatchEvent(new MouseEvent('mouseup', { ...common, button: 2, buttons: 0 }));
      target.dispatchEvent(new MouseEvent('contextmenu', { ...common, button: 2, buttons: 0 }));
      const first = items();
      await wait(1000);
      lines.push(`${spot}: on ${on === cell ? 'the cell' : name(on)}; at once: ${first}; after 1 s: ${items()}`);
      await close();
    }
    lines.push(`menu closed: ${!menu()}`);
  }
  console.log(lines.join('\n'));
})();
